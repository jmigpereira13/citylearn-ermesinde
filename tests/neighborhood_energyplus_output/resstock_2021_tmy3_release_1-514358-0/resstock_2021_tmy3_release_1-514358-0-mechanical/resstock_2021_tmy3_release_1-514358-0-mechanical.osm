  Schedule Value;                         !- Output Variable or Output Meter Name

OS:EnergyManagementSystem:Program,
  {bb27e330-bf3d-4468-88e4-3d2e752602a2}, !- Handle
  res_shower_sag,                         !- Name
  If res_shower_vol > 0,                  !- Program Line 1
  Set ShowerTime=SystemTimeStep,          !- Program Line 2
  Else,                                   !- Program Line 3
  Set ShowerTime=0,                       !- Program Line 4
  EndIf,                                  !- Program Line 5
  If (res_shower_vol > 0) && (res_shower_mixsp > res_shower_tout), !- Program Line 6
  Set ShowerSag=SystemTimeStep,           !- Program Line 7
  Set ShowerE=res_shower_vol*4141170*(res_shower_mixsp-res_shower_tout), !- Program Line 8
  Else,                                   !- Program Line 9
  Set ShowerSag=0,                        !- Program Line 10
  Set ShowerE=0,                          !- Program Line 11
  EndIf;                                  !- Program Line 12

