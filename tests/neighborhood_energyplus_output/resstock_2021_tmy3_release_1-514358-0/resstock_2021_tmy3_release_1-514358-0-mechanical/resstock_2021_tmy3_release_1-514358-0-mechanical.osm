OS:EnergyManagementSystem:Subroutine,
  {9b04e113-7fa3-4864-9064-cdc7e0ebfa48}, !- Handle
  res_ds_res_ashp_htg_asys_lk_subrout,    !- Name
  Set f_sup = 0.04997502497502498,        !- Program Line 1
  Set f_ret = 0.025024975024975034,       !- Program Line 2
  Set f_OA = 0.024950049950049943,        !- Program Line 3
  Set oafrate = f_OA * res_ds_res_ashp_htg_asys_AhVfr, !- Program Line 4
  Set suplkfrate = f_sup * res_ds_res_ashp_htg_asys_AhVfr, !- Program Line 5
  Set retlkfrate = f_ret * res_ds_res_ashp_htg_asys_AhVfr, !- Program Line 6
  Set res_ds_res_ashp_htg_asys_AhToLiv = (@Abs (suplkfrate-retlkfrate-oafrate)), !- Program Line 7
  Set res_ds_res_ashp_htg_asys_LivToAh = 0, !- Program Line 8
  Set res_ds_res_ashp_htg_asys_lk_sup_fan_equiv = 0, !- Program Line 9
  Set res_ds_res_ashp_htg_asys_lk_ret_fan_equiv = oafrate, !- Program Line 10
  If res_ds_res_ashp_htg_asys_AhMfr>0,    !- Program Line 11
  Set h_SA=(@HFnTdbW res_ds_res_ashp_htg_asys_AhTt res_ds_res_ashp_htg_asys_AhWt), !- Program Line 12
  Set h_AHZ=(@HFnTdbW res_ds_res_ashp_htg_asys_AhT res_ds_res_ashp_htg_asys_AhW), !- Program Line 13
  Set h_RA=(@HFnTdbW res_ds_res_ashp_htg_asys_RaT res_ds_res_ashp_htg_asys_RaW), !- Program Line 14
  Set h_fg=(@HfgAirFnWTdb res_ds_res_ashp_htg_asys_AhWt res_ds_res_ashp_htg_asys_AhTt), !- Program Line 15
  Set SALkQtot=f_sup*res_ds_res_ashp_htg_asys_AhMfr*(h_RA-h_SA), !- Program Line 16
  Set temp1=h_fg*(res_ds_res_ashp_htg_asys_RaW-res_ds_res_ashp_htg_asys_AhWt), !- Program Line 17
  Set res_ds_res_ashp_htg_asys_SupLatLkToLv = f_sup*res_ds_res_ashp_htg_asys_AhMfr*temp1, !- Program Line 18
  Set res_ds_res_ashp_htg_asys_SupSLkToLv = SALkQtot-res_ds_res_ashp_htg_asys_SupLatLkToLv, !- Program Line 19
  Set eTm=(res_ds_res_ashp_htg_asys_FanRtf/(res_ds_res_ashp_htg_asys_AhMfr*1006.0))*42.211, !- Program Line 20
  Set eTm=0-eTm,                          !- Program Line 21
  Set temp4=res_ds_res_ashp_htg_asys_AhT, !- Program Line 22
  Set tsup=temp4+((res_ds_res_ashp_htg_asys_AhTt-res_ds_res_ashp_htg_asys_AhT)*(@Exp eTm)), !- Program Line 23
  Set temp5=tsup-res_ds_res_ashp_htg_asys_AhTt, !- Program Line 24
  Set res_ds_res_ashp_htg_asys_SupDCnToLv = res_ds_res_ashp_htg_asys_AhMfr*1006.0*temp5, !- Program Line 25
  Set res_ds_res_ashp_htg_asys_SupDCnToAh = 0-res_ds_res_ashp_htg_asys_SupDCnToLv, !- Program Line 26
  Set eTm=(res_ds_res_ashp_htg_asys_FanRtf/(res_ds_res_ashp_htg_asys_AhMfr*1006.0))*13.716, !- Program Line 27
  Set eTm=0-eTm,                          !- Program Line 28
  Set temp6=res_ds_res_ashp_htg_asys_AhT, !- Program Line 29
