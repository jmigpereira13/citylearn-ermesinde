EnergyManagementSystem:Program,
    res_ds_res_ashp_clg_asys_program,    !- Name
    Set res_ds_res_ashp_clg_asys_AhMfr = res_ds_res_ashp_clg_asys_ah_mfr_s,    !- Program Line 1
    Set res_ds_res_ashp_clg_asys_FanRtf = res_ds_res_ashp_clg_asys_fan_rtf_s,    !- Program Line 2
    Set res_ds_res_ashp_clg_asys_AhVfr = res_ds_res_ashp_clg_asys_ah_vfr_s,    !- Program Line 3
    Set res_ds_res_ashp_clg_asys_AhTt = res_ds_res_ashp_clg_asys_ah_tt_s,    !- Program Line 4
    Set res_ds_res_ashp_clg_asys_AhWt = res_ds_res_ashp_clg_asys_ah_wt_s,    !- Program Line 5
    Set res_ds_res_ashp_clg_asys_RaT = res_ds_res_ashp_clg_asys_ra_t_s,    !- Program Line 6
    Set res_ds_res_ashp_clg_asys_RaW = res_ds_res_ashp_clg_asys_ra_w_s,    !- Program Line 7
    Set res_ds_res_ashp_clg_asys_AhT = res_ds_res_ashp_clg_asys_ah_t_s,    !- Program Line 8
    Set res_ds_res_ashp_clg_asys_AhW = res_ds_res_ashp_clg_asys_ah_w_s,    !- Program Line 9
    Run res_ds_res_ashp_clg_asys_lk_subrout,    !- Program Line 10
    Set res_ds_res_ashp_clg_asys_SupSLkToLvEq_act = res_ds_res_ashp_clg_asys_SupSLkToLv,    !- Program Line 11
    Set res_ds_res_ashp_clg_asys_SupLatLkToLvEq_act = res_ds_res_ashp_clg_asys_SupLatLkToLv,    !- Program Line 12
    Set res_ds_res_ashp_clg_asys_SupDCnToLvEq_act = res_ds_res_ashp_clg_asys_SupDCnToLv,    !- Program Line 13
    Set res_ds_res_ashp_clg_asys_SupDCnToAhEq_act = res_ds_res_ashp_clg_asys_SupDCnToAh,    !- Program Line 14
    Set res_ds_res_ashp_clg_asys_SupSLkToAhEq_act = res_ds_res_ashp_clg_asys_SupSLkToAh,    !- Program Line 15
    Set res_ds_res_ashp_clg_asys_SupLatLkToAhEq_act = res_ds_res_ashp_clg_asys_SupLatLkToAh,    !- Program Line 16
    Set res_ds_res_ashp_clg_asys_RetSLkEq_act = res_ds_res_ashp_clg_asys_RetSLk,    !- Program Line 17
    Set res_ds_res_ashp_clg_asys_RetLatLkEq_act = res_ds_res_ashp_clg_asys_RetLatLk,    !- Program Line 18
    Set res_ds_res_ashp_clg_asys_RetDCnToPlEq_act = res_ds_res_ashp_clg_asys_RetDCnToPl,    !- Program Line 19
    Set res_ds_res_ashp_clg_asys_RetDCnToAhEquip_act = res_ds_res_ashp_clg_asys_RetDCnToAh,    !- Program Line 20
    Set res_ds_res_ashp_clg_asys_AhToLivMix_act = res_ds_res_ashp_clg_asys_AhToLiv,    !- Program Line 21
    Set res_ds_res_ashp_clg_asys_LivToAhMix_act = res_ds_res_ashp_clg_asys_LivToAh;    !- Program Line 22

EnergyManagementSystem:Program,
    res_ds_res_ashp_htg_asys_program,    !- Name
    Set res_ds_res_ashp_htg_asys_AhMfr = res_ds_res_ashp_htg_asys_ah_mfr_s,    !- Program Line 1
    Set res_ds_res_ashp_htg_asys_FanRtf = res_ds_res_ashp_htg_asys_fan_rtf_s,    !- Program Line 2
    Set res_ds_res_ashp_htg_asys_AhVfr = res_ds_res_ashp_htg_asys_ah_vfr_s,    !- Program Line 3
    Set res_ds_res_ashp_htg_asys_AhTt = res_ds_res_ashp_htg_asys_ah_tt_s,    !- Program Line 4
    Set res_ds_res_ashp_htg_asys_AhWt = res_ds_res_ashp_htg_asys_ah_wt_s,    !- Program Line 5
    Set res_ds_res_ashp_htg_asys_RaT = res_ds_res_ashp_htg_asys_ra_t_s,    !- Program Line 6
    Set res_ds_res_ashp_htg_asys_RaW = res_ds_res_ashp_htg_asys_ra_w_s,    !- Program Line 7
    Set res_ds_res_ashp_htg_asys_AhT = res_ds_res_ashp_htg_asys_ah_t_s,    !- Program Line 8
    Set res_ds_res_ashp_htg_asys_AhW = res_ds_res_ashp_htg_asys_ah_w_s,    !- Program Line 9
    Run res_ds_res_ashp_htg_asys_lk_subrout,    !- Program Line 10
    Set res_ds_res_ashp_htg_asys_SupSLkToLvEq_act = res_ds_res_ashp_htg_asys_SupSLkToLv,    !- Program Line 11
    Set res_ds_res_ashp_htg_asys_SupLatLkToLvEq_act = res_ds_res_ashp_htg_asys_SupLatLkToLv,    !- Program Line 12
    Set res_ds_res_ashp_htg_asys_SupDCnToLvEq_act = res_ds_res_ashp_htg_asys_SupDCnToLv,    !- Program Line 13
    Set res_ds_res_ashp_htg_asys_SupDCnToAhEq_act = res_ds_res_ashp_htg_asys_SupDCnToAh,    !- Program Line 14
    Set res_ds_res_ashp_htg_asys_SupSLkToAhEq_act = res_ds_res_ashp_htg_asys_SupSLkToAh,    !- Program Line 15
    Set res_ds_res_ashp_htg_asys_SupLatLkToAhEq_act = res_ds_res_ashp_htg_asys_SupLatLkToAh,    !- Program Line 16
    Set res_ds_res_ashp_htg_asys_RetSLkEq_act = res_ds_res_ashp_htg_asys_RetSLk,    !- Program Line 17
    Set res_ds_res_ashp_htg_asys_RetLatLkEq_act = res_ds_res_ashp_htg_asys_RetLatLk,    !- Program Line 18
    Set res_ds_res_ashp_htg_asys_RetDCnToPlEq_act = res_ds_res_ashp_htg_asys_RetDCnToPl,    !- Program Line 19
    Set res_ds_res_ashp_htg_asys_RetDCnToAhEquip_act = res_ds_res_ashp_htg_asys_RetDCnToAh,    !- Program Line 20
    Set res_ds_res_ashp_htg_asys_AhToLivMix_act = res_ds_res_ashp_htg_asys_AhToLiv,    !- Program Line 21
    Set res_ds_res_ashp_htg_asys_LivToAhMix_act = res_ds_res_ashp_htg_asys_LivToAh;    !- Program Line 22

EnergyManagementSystem:Program,
    res_infil_1_program,      !- Name
    Set p_m = 0.14,           !- Program Line 1
    Set p_s = 0.22,           !- Program Line 2
    Set s_m = 270,            !- Program Line 3
    Set s_s = 370,            !- Program Line 4
    Set z_m = 9.99744,        !- Program Line 5
    Set z_s = 4.8768,         !- Program Line 6
    Set f_t = (((s_m/z_m)^p_m)*((z_s/s_s)^p_s)),    !- Program Line 7
    Set Tdiff = res_af_1_tin_s-res_af_1_tt_s,    !- Program Line 8
    Set dT = @Abs Tdiff,      !- Program Line 9
    Set c = 0.0533,           !- Program Line 10
    Set Cs = 0.0868,          !- Program Line 11
    Set Cw = 0.1588,          !- Program Line 12
    Set n = 0.65,             !- Program Line 13
    Set sft = (f_t*0.5),      !- Program Line 14
    Set temp1 = ((c*Cw)*((sft*res_af_vw_s)^(2*n)))^2,    !- Program Line 15
    Set Qn = (((c*Cs*(dT^n))^2)+temp1)^0.5,    !- Program Line 16
    Set Tdiff = res_af_1_tin_s-res_af_1_tt_s,    !- Program Line 17
    Set QWHV = res_infil_1_wh_sch_s*0.0,    !- Program Line 18
    Set Qrange = res_infil_1_range_sch_s*0.0472,    !- Program Line 19
    Set Qdryer = res_infil_1_dryer_sch_s*0.0472,    !- Program Line 20
    Set Qbath = res_infil_1_bath_sch_s*0.0472,    !- Program Line 21
    Set QductsOut = 0,        !- Program Line 22
    Set QductsIn = 0,         !- Program Line 23
    Set QductsOut = QductsOut+res_ds_res_ashp_clg_asys_lk_ret_fan_equiv,    !- Program Line 24
    Set QductsIn = QductsIn+res_ds_res_ashp_clg_asys_lk_sup_fan_equiv,    !- Program Line 25
    Set QductsOut = QductsOut+res_ds_res_ashp_htg_asys_lk_ret_fan_equiv,    !- Program Line 26
    Set QductsIn = QductsIn+res_ds_res_ashp_htg_asys_lk_sup_fan_equiv,    !- Program Line 27
    Set Qout = Qrange+Qbath+Qdryer+QductsOut,    !- Program Line 28
    Set Qin = QWHV+QductsIn,    !- Program Line 29
    Set faneff_wh = 1,        !- Program Line 30
    Set res_infil_1_house_fan_act = (QWHV*300)/faneff_wh*0,    !- Program Line 31
    Set faneff_sp = 0.4719474432000001,    !- Program Line 32
    Set res_infil_1_range_fan_act = (Qrange*300)/faneff_sp,    !- Program Line 33
    Set res_infil_1_bath_fan_act = (Qbath*300)/faneff_sp,    !- Program Line 34
    Set Qfan = (@Max Qout Qin),    !- Program Line 35
    If Qfan > 0,              !- Program Line 36
    Set Qavg = ((Qout + Qin) / 2.0),    !- Program Line 37
    If ((@Abs (Qout - Qavg)) / Qavg) <= 0.1,    !- Program Line 38
    Set phi = 1,              !- Program Line 39
    Else,                     !- Program Line 40
    Set phi = (Qn / (Qn + Qfan)),    !- Program Line 41
    EndIf,                    !- Program Line 42
    Set Qinf_adj = phi * Qn,    !- Program Line 43
    Else,                     !- Program Line 44
    Set Qinf_adj = Qn,        !- Program Line 45
    EndIf,                    !- Program Line 46
    Set res_infil_1_flow_act = Qfan + Qinf_adj;    !- Program Line 47

EnergyManagementSystem:Program,
    res_nv_1_program,         !- Name
    Set Tdiff = res_af_1_tin_s-res_af_1_tt_s,    !- Program Line 1
    Set dT = (@Abs Tdiff),    !- Program Line 2
    Set pt = (@RhFnTdbWPb res_af_1_tt_s res_nv_wt_s res_nv_pb_s),    !- Program Line 3
    Set NVA = 10758.425143139686,    !- Program Line 4
    Set Cs = 0.00017926040778923255,    !- Program Line 5
    Set Cw = 8.70903777141566e-05,    !- Program Line 6
    Set MNV = 3.351456109977612,    !- Program Line 7
    Set MHR = 0.0115,         !- Program Line 8
    Set MRH = 0.7,            !- Program Line 9
    Set temp1 = (res_nv_1_nva_s*NVA),    !- Program Line 10
    Set SGNV = temp1*((((Cs*dT)+(Cw*(res_af_vw_s^2)))^0.5)/1000),    !- Program Line 11
    If (res_nv_wt_s<MHR) && (pt<MRH) && (res_af_1_tin_s>res_nv_1_sp_s),    !- Program Line 12
    Set temp2 = (res_af_1_tin_s-res_nv_1_sp_s),    !- Program Line 13
    Set NVadj1 = temp2/(res_af_1_tin_s-res_af_1_tt_s),    !- Program Line 14
    Set NVadj2 = (@Min NVadj1 1),    !- Program Line 15
    Set NVadj3 = (@Max NVadj2 0),    !- Program Line 16
    Set NVadj = SGNV*NVadj3,    !- Program Line 17
    Set res_nv_1_flow_act = (@Min NVadj MNV),    !- Program Line 18
    Else,                     !- Program Line 19
    Set res_nv_1_flow_act = 0,    !- Program Line 20
    EndIf;                    !- Program Line 21

EnergyManagementSystem:Program,
    res_shower_sag,           !- Name
    If res_shower_vol > 0,    !- Program Line 1
    Set ShowerTime=SystemTimeStep,    !- Program Line 2
    Else,                     !- Program Line 3
    Set ShowerTime=0,         !- Program Line 4
    EndIf,                    !- Program Line 5
    If (res_shower_vol > 0) && (res_shower_mixsp > res_shower_tout),    !- Program Line 6
    Set ShowerSag=SystemTimeStep,    !- Program Line 7
    Set ShowerE=res_shower_vol*4141170*(res_shower_mixsp-res_shower_tout),    !- Program Line 8
    Else,                     !- Program Line 9
    Set ShowerSag=0,          !- Program Line 10
    Set ShowerE=0,            !- Program Line 11
    EndIf;                    !- Program Line 12

EnergyManagementSystem:Subroutine,
    res_ds_res_ashp_clg_asys_lk_subrout,    !- Name
    Set f_sup = 0.04997502497502498,    !- Program Line 1
    Set f_ret = 0.025024975024975034,    !- Program Line 2
    Set f_OA = 0.024950049950049943,    !- Program Line 3
    Set oafrate = f_OA * res_ds_res_ashp_clg_asys_AhVfr,    !- Program Line 4
    Set suplkfrate = f_sup * res_ds_res_ashp_clg_asys_AhVfr,    !- Program Line 5
    Set retlkfrate = f_ret * res_ds_res_ashp_clg_asys_AhVfr,    !- Program Line 6
    Set res_ds_res_ashp_clg_asys_AhToLiv = (@Abs (suplkfrate-retlkfrate-oafrate)),    !- Program Line 7
    Set res_ds_res_ashp_clg_asys_LivToAh = 0,    !- Program Line 8
    Set res_ds_res_ashp_clg_asys_lk_sup_fan_equiv = 0,    !- Program Line 9
    Set res_ds_res_ashp_clg_asys_lk_ret_fan_equiv = oafrate,    !- Program Line 10
    If res_ds_res_ashp_clg_asys_AhMfr>0,    !- Program Line 11
    Set h_SA=(@HFnTdbW res_ds_res_ashp_clg_asys_AhTt res_ds_res_ashp_clg_asys_AhWt),    !- Program Line 12
    Set h_AHZ=(@HFnTdbW res_ds_res_ashp_clg_asys_AhT res_ds_res_ashp_clg_asys_AhW),    !- Program Line 13
    Set h_RA=(@HFnTdbW res_ds_res_ashp_clg_asys_RaT res_ds_res_ashp_clg_asys_RaW),    !- Program Line 14
    Set h_fg=(@HfgAirFnWTdb res_ds_res_ashp_clg_asys_AhWt res_ds_res_ashp_clg_asys_AhTt),    !- Program Line 15
    Set SALkQtot=f_sup*res_ds_res_ashp_clg_asys_AhMfr*(h_RA-h_SA),    !- Program Line 16
    Set temp1=h_fg*(res_ds_res_ashp_clg_asys_RaW-res_ds_res_ashp_clg_asys_AhWt),    !- Program Line 17
    Set res_ds_res_ashp_clg_asys_SupLatLkToLv = f_sup*res_ds_res_ashp_clg_asys_AhMfr*temp1,    !- Program Line 18
    Set res_ds_res_ashp_clg_asys_SupSLkToLv = SALkQtot-res_ds_res_ashp_clg_asys_SupLatLkToLv,    !- Program Line 19
    Set eTm=(res_ds_res_ashp_clg_asys_FanRtf/(res_ds_res_ashp_clg_asys_AhMfr*1006.0))*42.211,    !- Program Line 20
    Set eTm=0-eTm,            !- Program Line 21
    Set temp4=res_ds_res_ashp_clg_asys_AhT,    !- Program Line 22
    Set tsup=temp4+((res_ds_res_ashp_clg_asys_AhTt-res_ds_res_ashp_clg_asys_AhT)*(@Exp eTm)),    !- Program Line 23
    Set temp5=tsup-res_ds_res_ashp_clg_asys_AhTt,    !- Program Line 24
    Set res_ds_res_ashp_clg_asys_SupDCnToLv = res_ds_res_ashp_clg_asys_AhMfr*1006.0*temp5,    !- Program Line 25
    Set res_ds_res_ashp_clg_asys_SupDCnToAh = 0-res_ds_res_ashp_clg_asys_SupDCnToLv,    !- Program Line 26
    Set eTm=(res_ds_res_ashp_clg_asys_FanRtf/(res_ds_res_ashp_clg_asys_AhMfr*1006.0))*13.716,    !- Program Line 27
    Set eTm=0-eTm,            !- Program Line 28
    Set temp6=res_ds_res_ashp_clg_asys_AhT,    !- Program Line 29
    Set tret=temp6+((res_ds_res_ashp_clg_asys_RaT-res_ds_res_ashp_clg_asys_AhT)*(@Exp eTm)),    !- Program Line 30
    Set temp7=tret-res_ds_res_ashp_clg_asys_RaT,    !- Program Line 31
    Set res_ds_res_ashp_clg_asys_RetDCnToPl=res_ds_res_ashp_clg_asys_AhMfr*1006.0*temp7,    !- Program Line 32
    Set res_ds_res_ashp_clg_asys_RetDCnToAh=0-res_ds_res_ashp_clg_asys_RetDCnToPl,    !- Program Line 33
    Set res_ds_res_ashp_clg_asys_RetLatLk=0,    !- Program Line 34
    Set temp2=(res_ds_res_ashp_clg_asys_AhT-res_ds_res_ashp_clg_asys_RaT),    !- Program Line 35
    Set res_ds_res_ashp_clg_asys_RetSLk=f_ret*res_ds_res_ashp_clg_asys_AhMfr*1006.0*temp2,    !- Program Line 36
    Set QtLkToAHZn=f_sup*res_ds_res_ashp_clg_asys_AhMfr*(h_SA-h_AHZ),    !- Program Line 37
    Set temp3=(res_ds_res_ashp_clg_asys_AhWt-res_ds_res_ashp_clg_asys_AhW),    !- Program Line 38
    Set res_ds_res_ashp_clg_asys_SupLatLkToAh=f_sup*res_ds_res_ashp_clg_asys_AhMfr*h_fg,    !- Program Line 39
    Set res_ds_res_ashp_clg_asys_SupLatLkToAh=res_ds_res_ashp_clg_asys_SupLatLkToAh*temp3,    !- Program Line 40
    Set res_ds_res_ashp_clg_asys_SupSLkToAh=QtLkToAHZn-res_ds_res_ashp_clg_asys_SupLatLkToAh,    !- Program Line 41
    Else,                     !- Program Line 42
    Set res_ds_res_ashp_clg_asys_SupLatLkToLv=0,    !- Program Line 43
    Set res_ds_res_ashp_clg_asys_SupSLkToLv=0,    !- Program Line 44
    Set res_ds_res_ashp_clg_asys_SupDCnToLv=0,    !- Program Line 45
    Set res_ds_res_ashp_clg_asys_SupDCnToAh=0,    !- Program Line 46
    Set res_ds_res_ashp_clg_asys_RetDCnToPl=0,    !- Program Line 47
    Set res_ds_res_ashp_clg_asys_RetDCnToAh=0,    !- Program Line 48
    Set res_ds_res_ashp_clg_asys_RetLatLk=0,    !- Program Line 49
    Set res_ds_res_ashp_clg_asys_RetSLk=0,    !- Program Line 50
    Set res_ds_res_ashp_clg_asys_SupLatLkToAh=0,    !- Program Line 51
    Set res_ds_res_ashp_clg_asys_SupSLkToAh=0,    !- Program Line 52
    EndIf;                    !- Program Line 53

