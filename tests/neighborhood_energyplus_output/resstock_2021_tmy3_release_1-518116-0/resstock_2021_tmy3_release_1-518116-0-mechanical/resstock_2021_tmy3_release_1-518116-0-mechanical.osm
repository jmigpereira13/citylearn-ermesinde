OS:EnergyManagementSystem:Actuator,
  {ec01a7ee-883c-42c6-9049-a3cc03b09067}, !- Handle
  res_nv_1_flow_act,                      !- Name
  {1d81836a-20da-4f9f-b9d3-d57e7ab726cb}, !- Actuated Component Name
